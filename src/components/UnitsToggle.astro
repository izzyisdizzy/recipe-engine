---
/**
 * The US ↔ Grams segmented control — Dizzy's `.dz-seg`, styled entirely by `aria-pressed`. A
 * recipe page renders it twice (Ingredients and Steps headers) but the two are one control:
 * client/recipe-units.ts drives every `[data-units-btn]` on the page from a single apply(), so
 * clicking either updates both and both reflect the stored mode on load.
 *
 * Deliberately carries no `id` (instances are found via `[data-units-toggle]`), since two
 * renderings of the same markup would otherwise duplicate it.
 */
interface Props {
  label?: string;
}

const { label = 'Ingredient units' } = Astro.props;
---

<div data-units-toggle class="dz-seg" role="group" aria-label={label}>
  <button type="button" data-units-btn="us" class="dz-seg__btn" aria-pressed="true">US</button>
  <button type="button" data-units-btn="grams" class="dz-seg__btn" aria-pressed="false">Grams</button>
</div>
