---
/**
 * One row of a recipe index, a Dizzy `.dz-row`: title, category, and an optional edit link
 * (plus a thumbnail only if the recipe has an image; recipes normally don't). The wrapper
 * carries `data-recipe-card`, `data-category` and a folded `data-search` string so the index
 * page's own script can filter rows without re-deriving anything.
 */
import { Image } from 'astro:assets';
import type { RecipeEntry } from '../schema';
import { ingredientLabel } from '../units';

interface Props {
  recipe: RecipeEntry;
  /** The recipe's page. Defaults to `/recipes/<id>/`. */
  href?: string;
  /** Where the ✎ link points. Omit for no link. Carries `auth-only`, gated by the site's CSS. */
  editHref?: string;
}

const { recipe, href = `/recipes/${recipe.id}/`, editHref } = Astro.props;
const { title, category, keywords, tools, ingredients, steps, image } = recipe.data;

// Everything a keyword search should match against, folded into one lowercase string. Step
// text is searched with any [[key|label]] brackets reduced to what the reader sees.
const searchText = [
  title,
  category,
  ...keywords,
  ...tools,
  ...ingredients.flatMap((group) => [group.group ?? '', ...group.items.map(ingredientLabel)]),
  ...steps.flatMap((group) => [
    group.group ?? '',
    ...group.items.map((step) => step.replace(/\[\[\s*([^\]|]+?)\s*(?:\|\s*([^\]]+?)\s*)?\]\]/g, (_, key, label) => label ?? key.replace(/-/g, ' '))),
  ]),
]
  .join(' ')
  .toLowerCase();
---

<!-- Wrapper (not the link) carries the search/filter data attributes so the index can hide the
     whole row (main link and edit link) as one unit. Anchors can't nest, hence the split. -->
<div data-recipe-card data-category={category} data-search={searchText} class="rx-card">
  <a href={href} class="dz-row rx-card__link">
    {image && <Image src={image} alt="" class="dz-row__thumb" width={112} height={112} />}
    <h3 class="dz-row__title">{title}</h3>
    <span class="dz-row__meta">{category}</span>
  </a>
  {editHref && (
    <a href={editHref} aria-label={`Edit ${title}`} class="auth-only rx-card__edit">✎</a>
  )}
</div>
