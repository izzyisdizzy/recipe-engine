---
/**
 * A full recipe: title, meta, tools, ingredients (with the US ↔ grams toggle), linked steps
 * (popovers + "Show amounts"), and notes — as a bare <article>. It deliberately does not wrap
 * itself in a page layout; the consuming site supplies its own shell around it.
 *
 * Needs `@izzy/recipe-engine/styles/recipes.css` imported into the site's Tailwind entry
 * stylesheet (it styles the step HTML and registers this package with Tailwind's scanner).
 */
import UnitsToggle from './UnitsToggle.astro';
import type { RecipeEntry } from '../schema';
import { inlineMarkdown } from '../markdown';
import { toGrams, formatGrams, ingredientLabel, withDetail, type Densities } from '../units';
import { buildIngredientIndex, createLinkState, linkIngredientsInHtml } from '../ingredients';

interface Props {
  recipe: RecipeEntry;
  /** Grams-per-cup table used for US → grams conversion (the site owns it). */
  densities: Densities;
  /**
   * Where the "Edit recipe" link points. Omit for no link. The link carries the `auth-only`
   * class, so the site's own auth CSS decides when it's visible.
   */
  editHref?: string;
}

const { recipe, densities, editHref } = Astro.props;
const { title, category, prepTime, cookTime, servings, tools, ingredients, steps, notes } = recipe.data;

const hasMeta = prepTime !== undefined || cookTime !== undefined || servings !== undefined;

// Precompute each ingredient's US label and, where the ingredient's grams-per-cup ratio is
// known (or the unit is already a weight), its grams label. Items that can't be converted
// (no/unknown unit or density) have grams === null and always show the US text.
const ingredientGroups = ingredients.map((group) => ({
  group: group.group,
  items: group.items.map((item) => {
    const us = ingredientLabel(item);
    const grams = toGrams(item.qty, item.unit, item.name, densities);
    return {
      us,
      grams: grams === null ? null : withDetail(`${formatGrams(grams)} ${item.name}`, item.detail),
    };
  }),
}));
const anyConvertible = ingredientGroups.some((group) => group.items.some((item) => item.grams !== null));

// Index the recipe's ingredients so mentions in the step prose can be linked to their
// measurement. `tools` is the avoid list: a tool name that happens to contain an ingredient
// word ("Egg beater") must not pull that ingredient's amount into the prose.
const ingredientIndex = buildIngredientIndex(
  ingredients,
  (item) => {
    const grams = toGrams(item.qty, item.unit, item.name, densities);
    return grams === null ? null : formatGrams(grams);
  },
  tools
);
// Link every step up front, in render order. One state object threads the popover id
// counter, the set of ingredients that have already been given an inline amount (only the
// first mention of each gets one), and the count of mentions that actually took one — which
// is what gates the "Show amounts" button, with no sniffing of the generated HTML. Render
// order matters now that the output is order-dependent, so this must stay a plain map.
const linkState = createLinkState();
const stepGroups = steps.map((group) => ({
  group: group.group,
  items: group.items.map((step) => linkIngredientsInHtml(inlineMarkdown(step), ingredientIndex, linkState)),
}));
const hasInlineAmounts = (linkState.inlineable ?? 0) > 0;
// The Steps-header units toggle drives the amounts baked into the prose — popovers included —
// so it earns its place only when a step actually names an ingredient.
const anyStepAmounts = anyConvertible && linkState.n > 0;
---

<article>
  <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">{title}</h1>

  <p class="mt-2 text-sm capitalize text-neutral-500 dark:text-neutral-500">{category}</p>

  {editHref && (
    <a
      href={editHref}
      class="auth-only mt-1 inline-flex items-center gap-1 text-xs text-neutral-400 hover:text-accent-600 hover:underline dark:text-neutral-500 dark:hover:text-accent-100"
    >
      ✎ Edit recipe
    </a>
  )}

  {hasMeta && (
    <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 rounded-lg bg-neutral-50 px-4 py-3 text-sm dark:bg-neutral-900">
      {prepTime !== undefined && (
        <div class="flex gap-1.5">
          <dt class="text-neutral-500 dark:text-neutral-500">Prep</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-200">{prepTime} min</dd>
        </div>
      )}
      {cookTime !== undefined && (
        <div class="flex gap-1.5">
          <dt class="text-neutral-500 dark:text-neutral-500">Cook</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-200">{cookTime} min</dd>
        </div>
      )}
      {servings !== undefined && (
        <div class="flex gap-1.5">
          <dt class="text-neutral-500 dark:text-neutral-500">Servings</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-200">{servings}</dd>
        </div>
      )}
    </dl>
  )}

  {tools.length > 0 && (
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Tools</h2>
      <div class="mt-2 flex flex-wrap gap-1.5">
        {tools.map((tool) => (
          <span class="rounded-md border border-neutral-200 px-2 py-1 text-xs text-neutral-600 dark:border-neutral-800 dark:text-neutral-400">
            {tool}
          </span>
        ))}
      </div>
    </section>
  )}

  <section class="mt-8">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Ingredients</h2>
      {anyConvertible && <UnitsToggle />}
    </div>
    <div id="ingredients-list" class="mt-3 space-y-4" data-units="us">
      {ingredientGroups.map((group) => (
        <div>
          {group.group && <h3 class="mb-1.5 font-medium text-neutral-800 dark:text-neutral-200">{group.group}</h3>}
          <ul class="space-y-1">
            {group.items.map((item) => (
              <li class:list={['ing-item flex gap-2 text-neutral-700 dark:text-neutral-300', { 'is-convertible': item.grams !== null }]}>
                <span class="text-accent-600 dark:text-accent-100" aria-hidden="true">&bull;</span>
                <span class="ing-us">{item.us}</span>
                {item.grams !== null && <span class="ing-grams">{item.grams}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-8">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Steps</h2>
      {anyStepAmounts && <UnitsToggle label="Ingredient units in steps" />}
    </div>
    <div class="mt-3 space-y-4">
      {stepGroups.map((group) => (
        <div>
          {group.group && <h3 class="mb-1.5 font-medium text-neutral-800 dark:text-neutral-200">{group.group}</h3>}
          <ol class="space-y-3">
            {group.items.map((html, i) => (
              <li class="flex gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-50 text-xs font-medium text-accent-700 dark:bg-neutral-800 dark:text-accent-100">
                  {i + 1}
                </span>
                <span class="text-neutral-700 dark:text-neutral-300" set:html={html} />
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
    {hasInlineAmounts && (
      <div class="mt-4 flex justify-end">
        <button
          type="button"
          id="amounts-toggle"
          aria-pressed="false"
          class="rounded-lg border border-neutral-200 px-2.5 py-1 text-xs font-medium text-neutral-500 dark:border-neutral-800 dark:text-neutral-400"
        >Show amounts</button>
      </div>
    )}
  </section>

  {notes.length > 0 && (
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-500">Notes</h2>
      <ul class="mt-3 space-y-1.5">
        {notes.map((note) => (
          <li class="text-sm text-neutral-600 dark:text-neutral-400">{note}</li>
        ))}
      </ul>
    </section>
  )}
</article>

<style>
  /* US mode: hide the grams labels. Grams mode: hide the US label only on items that have a
     grams equivalent — non-convertible items keep showing their US text in both modes. */
  #ingredients-list[data-units='us'] .ing-grams {
    display: none;
  }
  #ingredients-list[data-units='grams'] .is-convertible .ing-us {
    display: none;
  }
</style>

<script>
  import { initIngredientPopovers } from '../ingredient-popover';
  import { initUnitsToggle } from '../client/recipe-units';
  import { initAmountsToggle } from '../client/recipe-amounts';

  // Tap-toggle + dismissal for the ingredient-measurement popovers in the steps (hover/focus
  // are pure CSS; this only adds touch and Escape/outside-click behavior).
  initIngredientPopovers();

  // Ingredient unit toggle (US ↔ Grams), rendered in both the Ingredients and Steps headers.
  initUnitsToggle();

  // "Show amounts" — move the step measurements from their popovers into the prose.
  initAmountsToggle();
</script>
