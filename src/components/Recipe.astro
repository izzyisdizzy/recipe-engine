---
/**
 * A full recipe: title, meta, tools, ingredients (with the US ↔ grams toggle), linked steps
 * (popovers + "Show amounts"), and notes — as a bare <article>. It deliberately does not wrap
 * itself in a page layout; the consuming site supplies its own shell around it. Each section is a
 * Dizzy window (`dz-window`, titled like a file: ingredients.txt, steps.txt, ...) whose heading and
 * toggles form the first row of the window body; the bar carries only the lights and file name.
 *
 * The title's `data-dz-bounce="once"` (one wave on load, then on hover) relies on izzybennett.com's
 * patched Dizzy bundle.js; stock Dizzy reads an unknown trigger as a continuous bounce.
 *
 * Styled by Dizzy: the site must load Dizzy's tokens and `bundle.css` (the `dz-*` classes), and
 * import `@izzy/recipe-engine/styles/recipes.css` into its Tailwind entry stylesheet (the
 * `.rx-*` / `.ing-*` rules, and the @source registration for this package).
 */
import UnitsToggle from './UnitsToggle.astro';
import RecipeWindow from './RecipeWindow.astro';
import type { RecipeEntry } from '../schema';
import { toGrams, formatGrams, withDetail, type Densities } from '../units';
import { buildIngredientIndex, createLinkState, linkStep, type StructuredItem } from '../ingredients';

interface Props {
  recipe: RecipeEntry;
  /** Grams-per-cup table used for US → grams conversion (the site owns it). */
  densities: Densities;
  /**
   * Where the "Edit recipe" link points. Omit for no link. The link carries the `auth-only`
   * class, so the site's own auth CSS decides when it's visible.
   */
  editHref?: string;
}

const { recipe, densities, editHref } = Astro.props;
const { title, description, category, prepTime, cookTime, servings, tools, ingredients, steps, notes } = recipe.data;
const recipeYield = recipe.data.yield;
const oven = recipe.data.oven;

const meta = [
  recipeYield && { label: 'Yield', value: recipeYield },
  servings !== undefined && { label: 'Serves', value: String(servings) },
  prepTime !== undefined && { label: 'Prep', value: `${prepTime} min` },
  cookTime !== undefined && { label: 'Cook', value: `${cookTime} min` },
  oven && { label: 'Oven', value: oven },
].filter((m): m is { label: string; value: string } => Boolean(m));

// An item's grams: its explicit override if it has one, else the density-table conversion.
const gramsOf = (item: StructuredItem): number | null =>
  item.grams ?? toGrams(item.qty, item.unit, item.name, densities);

// Precompute each ingredient's amount (US and, where convertible, grams) separately from its
// name, so the amount can be set in mono. Items that can't be converted have grams === null
// and always show the US text.
const ingredientGroups = ingredients.map((group) => ({
  group: group.group,
  items: group.items.map((item) => {
    const grams = gramsOf(item);
    return {
      name: withDetail(item.name, item.detail),
      us: [item.qty, item.unit].filter(Boolean).join(' '),
      grams: grams === null ? null : formatGrams(grams),
    };
  }),
}));
const anyConvertible = ingredientGroups.some((group) => group.items.some((item) => item.grams !== null));

// Index the recipe's ingredients so mentions in the step prose can be linked to their
// measurement. `tools` is the avoid list: a tool name that happens to contain an ingredient
// word ("Egg beater") must not pull that ingredient's amount into the prose.
const ingredientIndex = buildIngredientIndex(
  ingredients,
  (item) => {
    const grams = gramsOf(item);
    return grams === null ? null : formatGrams(grams);
  },
  tools
);
// Link every step up front, in render order — `[[key]]` references explicitly, other prose
// lexically. One state object threads the popover id counter, the set of ingredients that
// already have an inline amount (only the first mention of each gets one), and the count of
// mentions that took one — which gates the "Show amounts" button. Order matters, so this must
// stay a plain map. An unknown or ambiguous [[key]] throws here and fails the build.
const linkState = createLinkState();
const stepGroups = steps.map((group) => ({
  group: group.group,
  items: group.items.map((step) => linkStep(step, ingredientIndex, linkState)),
}));
const hasInlineAmounts = (linkState.inlineable ?? 0) > 0;
// The Steps-header units toggle drives the amounts baked into the prose — popovers included —
// so it earns its place only when a step actually names an ingredient.
const anyStepAmounts = anyConvertible && linkState.n > 0;
---

<article class="rx-recipe">
  <header>
    <!-- The tag gets its own line: Dizzy's bouncify makes the title inline-block, which would
         otherwise flow it up beside the tag. -->
    <p class="rx-kicker"><span class="dz-tag dz-tag--pink">{category}</span></p>
    <h1 class="rx-title" data-dz-bounce="once">{title}</h1>
    {description && <p class="rx-lede">{description}</p>}
    {editHref && <a href={editHref} class="auth-only dz-link rx-edit">✎ Edit recipe</a>}

    {meta.length > 0 && (
      <dl class="rx-meta">
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </header>

  {tools.length > 0 && (
    <RecipeWindow title="tools.txt" labelledby="rx-tools">
      <div class="rx-section__head">
        <h2 id="rx-tools" class="rx-h2">Tools</h2>
      </div>
      <ul class="rx-tools">
        {tools.map((tool) => <li class="dz-tag">{tool}</li>)}
      </ul>
    </RecipeWindow>
  )}

  <RecipeWindow title="ingredients.txt" labelledby="rx-ingredients">
    <div class="rx-section__head">
      <h2 id="rx-ingredients" class="rx-h2">Ingredients</h2>
      {anyConvertible && <UnitsToggle />}
    </div>
    <div id="ingredients-list" class="rx-ingredients" data-units="us">
      {ingredientGroups.map((group) => (
        <div>
          {group.group && <h3 class="rx-h3">{group.group}</h3>}
          <ul class="rx-ing-list">
            {group.items.map((item) => (
              <li class:list={['rx-ing', { 'is-convertible': item.grams !== null }]}>
                {item.us && <span class="rx-amt ing-us">{item.us}</span>}
                {item.grams !== null && <span class="rx-amt ing-grams">{item.grams}</span>}
                <span class="rx-ing__name">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </RecipeWindow>

  <RecipeWindow title="steps.txt" labelledby="rx-steps">
    <div class="rx-section__head">
      <h2 id="rx-steps" class="rx-h2">Steps</h2>
      <div class="rx-section__tools">
        {hasInlineAmounts && (
          <button type="button" id="amounts-toggle" aria-pressed="false" class="dz-btn dz-btn--ghost dz-btn--sm rx-amounts-btn">
            Show amounts
          </button>
        )}
        {anyStepAmounts && <UnitsToggle label="Ingredient units in steps" />}
      </div>
    </div>
    {stepGroups.map((group) => (
      <div class="rx-step-group">
        {group.group && <h3 class="rx-h3">{group.group}</h3>}
        <ol class="rx-steps">
          {group.items.map((html, i) => (
            <li class="rx-step">
              <span class="rx-step__num" aria-hidden="true">{i + 1}</span>
              <span class="rx-step__text" set:html={html} />
            </li>
          ))}
        </ol>
      </div>
    ))}
  </RecipeWindow>

  {notes.length > 0 && (
    <RecipeWindow title="notes.txt" labelledby="rx-notes">
      <div class="rx-section__head">
        <h2 id="rx-notes" class="rx-h2">Notes</h2>
      </div>
      <ul class="rx-notes">
        {notes.map((note) => <li>{note}</li>)}
      </ul>
    </RecipeWindow>
  )}
</article>

<script>
  import { initIngredientPopovers } from '../ingredient-popover';
  import { initUnitsToggle } from '../client/recipe-units';
  import { initAmountsToggle } from '../client/recipe-amounts';

  // Tap-toggle + dismissal for the ingredient-measurement popovers in the steps (hover/focus
  // are pure CSS; this only adds touch and Escape/outside-click behavior).
  initIngredientPopovers();

  // Ingredient unit toggle (US ↔ Grams), rendered in both the Ingredients and Steps headers.
  initUnitsToggle();

  // "Show amounts" — move the step measurements from their popovers into the prose.
  initAmountsToggle();
</script>
