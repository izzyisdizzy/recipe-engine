{
  "name": "@izzy/recipe-engine",
  "version": "1.1.0",
  "description": "Recipes for Astro sites: content schema, US-to-grams conversion, ingredient/step linking, and the recipe page + index card components.",
  "type": "module",
  "repository": "github:izzyisdizzy/recipe-engine",
  "keywords": [
    "astro-component"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "seed",
    "styles"
  ],
  "exports": {
    "./schema": "./src/schema.ts",
    "./units": "./src/units.ts",
    "./ingredients": "./src/ingredients.ts",
    "./markdown": "./src/markdown.ts",
    "./ingredient-suggest": "./src/ingredient-suggest.ts",
    "./ingredient-popover": "./src/ingredient-popover.ts",
    "./recipe-units": "./src/client/recipe-units.ts",
    "./recipe-amounts": "./src/client/recipe-amounts.ts",
    "./components/Recipe.astro": "./src/components/Recipe.astro",
    "./components/RecipeCard.astro": "./src/components/RecipeCard.astro",
    "./styles/recipes.css": "./styles/recipes.css",
    "./styles/theme.css": "./styles/theme.css",
    "./seed/densities.json": "./seed/densities.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && astro check"
  },
  "peerDependencies": {
    "astro": "^7.2.8"
  },
  "dependencies": {
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.8",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
